{
  "name": "@tron/api",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "main": "index.js",
  "scripts": {
    "celery:flower": "uv run celery -A src.celery.tasks flower",
    "celery:worker": "uv run celery -A src.celery.tasks worker --loglevel=INFO",
    "check-types": "source .venv/bin/activate && pyright",
    "dev": "fastapi dev main.py",
    "docker:deps:down": "docker compose -f compose.deps.yml down --remove-orphans",
    "docker:deps:up": "docker compose -f compose.deps.yml up --build -d",
    "docker:dev:down": "docker compose -f compose.dev.yml down --remove-orphans",
    "docker:dev:up": "docker compose -f compose.dev.yml up --build -d",
    "docker:prod:down": "docker compose -f compose.prod.yml down --remove-orphans",
    "docker:prod:up": "docker compose -f compose.prod.yml up --build -d",
    "format": "uv run ruff format",
    "lint": "uv run ruff check",
    "migrate": "uv run alembic upgrade head",
    "migration:history": "uv run alembic history --verbose",
    "start": "fastapi run main.py"
  }
}
